# ── Supabase ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
DATABASE_URL=postgres://postgres:password@localhost:54322/postgres

# ── Redis (Upstash) ──────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# ── LLM provider (provider-agnostic layer) ──────────────────────────
# one of: openai | anthropic | gemini
LLM_PROVIDER=openai
# Optional: only needed if LLM_PROVIDER is anthropic (no embeddings API);
# defaults to openai automatically if unset.
LLM_EMBEDDING_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── API ───────────────────────────────────────────────────────────────
API_PORT=4000
API_URL=http://localhost:4000
# Used by StripeService to build Checkout success/cancel redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Observability: OpenTelemetry -> APM (see docs/OBSERVABILITY.md) ──
# Traces, metrics, and logs all export here via OTLP/HTTP. Defaults assume
# a local SigNoz OTel Collector; point elsewhere (Grafana, Honeycomb, SigNoz
# Cloud, ...) by changing the endpoint/headers — nothing else is backend-specific.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=splice-api

# ── Web (apps/web) ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# iron-session seal password for the app-context cookie (not auth) — must be >= 32 chars.
APP_SESSION_SECRET=
# Optional: product analytics. Leave unset to run with PostHog disabled.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Mobile (apps/mobile) ─────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
